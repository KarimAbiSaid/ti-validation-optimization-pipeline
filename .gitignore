__pycache__/
*.pyc
.ipynb_checkpoints/

# Result/archive dumps - not source, multi-GB, never belongs in git
_archive/
_results/
_results.zip
_results_okamoto_19.zip
# Judgment calls from our discussion - comment out any line below you'd rather commit instead
pipeline/configs/*.json
pipeline/configs/_archive/
pipeline/configs/_archive_pre_cleanup/
# Context summary for claude
pipeline/PROJECT_CONTEXT_SUMMARY.md

# Config Generation presets are personal/local by default — the folder
# itself stays tracked (README.md, _template.json), the actual saved
# presets don't. See gui/presets/README.md.
gui/presets/*.json
!gui/presets/_template.json

# Mask recipe books are personal/local by default — same convention as
# presets above. See gui/mask_recipes/README.md.
gui/mask_recipes/*.json
!gui/mask_recipes/_template.json